3. PROVIDER MODULE
PROVIDER module
PROCEDURE Provider.Module;
INTERFACE RETURNS provider.status;

PROCEDURE Provider.PostListing(listingData);
PRECONDITION AuthService.checkLoggedIn(current.user)
    AND current.user.role = PROVIDER;
BEGIN
    VALIDATE = Validation.validateListing(listingData);
    IF NOT VALIDATE.valid THEN
        RETURN provider.status = "INVALID_INPUT";
    END IF;

    listing = listingData;
    listing.providerId = current.user.id;
    listing.postedAt = now;
    listing.status = AVAILABLE;

    DB.Listing.save(listing);
    SearchIndex.update(listing);

    NotifService.broadcastNearby(listing.location,
        "new_listing",
        "New surplus posted nearby");

RETURN provider.status = "LISTING_POSTED";
END PROCEDURE;


PROCEDURE Provider.HandleReservation(reservationId, decision);
BEGIN
    reservation = DB.Reservation.get(reservationId);
    listing = DB.Listing.get(reservation.listingId);

    IF listing.providerId != current.user.id THEN
        RETURN provider.status = "NOT_AUTHORIZED";
    END IF;

    IF reservation.status != PENDING THEN
        RETURN provider.status = "INVALID_STATE";
    END IF;

    CASE decision OF

        WHEN "APPROVE" SELECT
            IF reservation.qty > listing.quantity THEN
                reservation.status = DECLINED;
                DB.Reservation.update(reservation);
                NotifService.create(reservation.requesterId, 
                    "request_declined", 
                    "Out of stock");
            ELSE
                listing.quantity = listing.quantity - reservation.qty;
                IF listing.quantity = 0 THEN 
                    listing.status = OUT_OF_STOCK;
                END IF;

                reservation.status = APPROVED;
                DB.Listing.update(listing);
                DB.Reservation.update(reservation);

                NotifService.create(reservation.requesterId,
                    "request_approved",
                    "Your request was approved");
            END IF;

        WHEN "DECLINE" SELECT
            reservation.status = DECLINED;
            DB.Reservation.update(reservation);
            NotifService.create(reservation.requesterId,
                "request_declined",
                "Provider declined your request");

    END CASE;

RETURN provider.status = "DONE";
END PROCEDURE;
END PROCEDURE;
4. CONSUMER MODULE
CONSUMER module
PROCEDURE Consumer.Module;
INTERFACE RETURNS consumer.status;

PROCEDURE Consumer.BrowseListings(filters);
BEGIN
    results = SearchService.queryListings(filters);
    RETURN results;
END PROCEDURE;

PROCEDURE Consumer.CreateReservation(listingId, qty, pickupWindow, paymentMethod);
PRECONDITION AuthService.checkLoggedIn(current.user)
    AND current.user.role = CONSUMER;
BEGIN
    listing = DB.Listing.get(listingId);

    IF listing.status != AVAILABLE OR qty > listing.quantity THEN
        RETURN consumer.status = "INSUFFICIENT_STOCK";
    END IF;

    reservation.id = DB.generateId();
    reservation.listingId = listingId;
    reservation.requesterId = current.user.id;
    reservation.qty = qty;
    reservation.pickupWindow = pickupWindow;
    reservation.paymentMethod = paymentMethod;
    reservation.createdAt = now;
    reservation.status = PENDING;

    DB.Reservation.save(reservation);

    NotifService.create(listing.providerId,
        "new_reservation",
        "You have a new reservation request");

RETURN consumer.status = "RESERVATION_CREATED";
END PROCEDURE;


PROCEDURE Consumer.ConfirmPickup(reservationId);
BEGIN
    reservation = DB.Reservation.get(reservationId);

    IF reservation.requesterId != current.user.id THEN
        RETURN consumer.status = "NOT_AUTHORIZED";
    END IF;

    IF reservation.status != APPROVED THEN
        RETURN consumer.status = "INVALID_STATE";
    END IF;

    reservation.status = COMPLETED;
    reservation.completedAt = now;

    DB.Reservation.update(reservation);
    Analytics.recordTransaction(reservation);

    NotifService.create(DB.Listing.get(reservation.listingId).providerId,
        "pickup_confirmed",
        "Pickup confirmed by consumer");

RETURN consumer.status = "PICKUP_CONFIRMED";
END PROCEDURE;

END PROCEDURE;

5. NGO MODULE
NGO module
PROCEDURE NGO.Module;
INTERFACE RETURNS ngo.status;

PROCEDURE NGO.RequestDonation(listingId, qty, reason);
PRECONDITION AuthService.checkLoggedIn(current.user)
    AND current.user.role = NGO;
BEGIN
    listing = DB.Listing.get(listingId);

    IF NOT listing.isDonation THEN
        RETURN ngo.status = "NOT_DONATION_ITEM";
    END IF;

    reservation = Consumer.CreateReservation(listingId, qty, "ASAP", "none");
    reservation.type = "DONATION";

    DB.Reservation.update(reservation);

    NotifService.create(listing.providerId,
        "donation_request",
        "NGO requested a donation");

RETURN ngo.status = "DONATION_REQUESTED";
END PROCEDURE;

END PROCEDURE;

