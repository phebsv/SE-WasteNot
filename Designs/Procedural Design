Procedural Design
1. ADMIN MODULE
ADMIN module
PROCEDURE Admin.Module;
INTERFACE RETURNS admin.status;

TYPE application IS STRUCTURE DEFINED
    id IS INTEGER;
    applicantName IS STRING LENGTH VAR;
    email IS STRING LENGTH VAR;
    orgType IS STRING LENGTH VAR; /* Provider or NGO */
    formData IS STRING LENGTH VAR;
    status IS STRING LENGTH VAR; /* Submitted, Incomplete, Approved, Rejected */
    reviewerId IS INTEGER;
    reviewedAt IS DATETIME;
END application TYPE;

PROCEDURE Admin.VerifyApplications;
PRECONDITION AuthService.checkLoggedIn(current.user) 
    AND current.user.role = ADMIN;
BEGIN
    responses = GoogleFormAPI.fetchResponses("partner_form_id");

    FOR EACH R IN responses DO
        IF DB.Application.exists(responseId = R.id) THEN CONTINUE; END IF;

        app = Application.fromForm(R);

        IF NOT Validation.hasRequiredFields(app.formData) THEN
            app.status = "Incomplete";
            DB.Application.save(app);
            EmailService.send(app.email, 
                "Application incomplete", 
                "Please resubmit missing requirements.");
            CONTINUE;
        END IF;

        IF NOT Validation.backgroundCheck(app) THEN
            app.status = "Rejected";
            DB.Application.save(app);
            EmailService.send(app.email, 
                "Application rejected", 
                "Failed verification.");
            CONTINUE;
        END IF;

        account = UserService.createAccount(app);
        app.status = "Approved";
        app.reviewerId = current.user.id;
        app.reviewedAt = now;
        DB.Application.update(app);

        EmailService.send(account.email,
            "Approved", 
            "Your account number: " + account.id);

    END FOR;

RETURN admin.status = "DONE";
END PROCEDURE;
