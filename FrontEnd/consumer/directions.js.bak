// Backend API Configuration
const API_URL = "http://localhost:8081/api";
let product = null;

// Load product from backend
async function loadProduct() {
  {
    id: 2,
    name: "Goldilocks Cake Slice",
    partner: "Goldilocks",
    price: 28,
    oldPrice: 45,
    discountPercent: 35,
    category: "breads",
    image: "goldilocks-slice.jpg",
